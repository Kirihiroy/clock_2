<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2B2B2B"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок: Отмена | Новый сигнал | Готово -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel_add_alarm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="#4DA3FF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_alarm"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_done_add_alarm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/done"
            android:textColor="#4DA3FF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Подсказка: обновляется динамически — показывает паттерн повтора -->
    <TextView
        android:id="@+id/tv_ring_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:textColor="#B0B0B0"
        android:textSize="14sp" />

    <!-- Выбор дней недели: Пн Вт Ср Чт Пт Сб Вс -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_day_mon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Пн"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_day_tue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Вт"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_day_wed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Ср"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_day_thu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Чт"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_day_fri"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Пт"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_day_sat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Сб"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_day_sun"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:gravity="center"
            android:text="Вс"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Выбор часов и минут -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3A3A3A"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="8dp">

        <NumberPicker
            android:id="@+id/np_hours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:descendantFocusability="blocksDescendants"
            android:theme="@style/ThemeOverlay.AppCompat.Dark" />

        <NumberPicker
            android:id="@+id/np_minutes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:descendantFocusability="blocksDescendants"
            android:theme="@style/ThemeOverlay.AppCompat.Dark" />
    </LinearLayout>

</LinearLayout>
